NODE_ENV=development
PORT=3000
API_PREFIX=/api
PUBLIC_APP_URL=http://localhost:9000
CORS_ORIGINS=http://localhost:9000,http://localhost:3000
TRUST_PROXY=1
COOKIE_SECURE=false

MONGODB_URI=mongodb://localhost:27017/notify_app
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false
MONGODB_ENSURE_INDEXES=true

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PROFILE_JWT_SECRET=
PROFILE_JWT_TTL=10m
PROFILE_CODE_TTL_SECONDS=600
PROFILE_CODE_MAX_ATTEMPTS=5
PROFILE_CODE_MAX_REQUESTS=5
PROFILE_CODE_WINDOW_SECONDS=3600
PROFILE_CODE_RESEND_SECONDS=60
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SEARCH_HASH_KEY=replace-with-another-at-least-32-random-secret
INVITE_TOKEN_SECRET=replace-with-another-at-least-32-random-secret

ADMIN1_EMAIL=admin@example.com
ADMIN1_PASSWORD=replace-with-a-strong-password
# ADMIN2_EMAIL=admin2@example.com
# ADMIN2_PASSWORD=replace-with-another-strong-password

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_MAX=20000
AUTH_RATE_LIMIT_MAX=10
IP_BLOCK_AFTER=20
IP_BLOCK_SECONDS=900

WHATSAPP_WEB_SESSION_MAX_AGE_DAYS=90
WHATSAPP_WEB_AUTO_INIT=false
WHATSAPP_WEB_AUTH_PATH=.wwebjs_auth
PUPPETEER_EXECUTABLE_PATH=

# As credenciais abaixo também podem ser cadastradas em runtime pela API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
GMAIL_FROM_NAME=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_API_VERSION=v25.0
TELEGRAM_BOT_USERNAME=
WHATSAPP_CLOUD_DISPLAY_PHONE_NUMBER=
START_NOTIFY_WHATSAPP_PERMISSION=/notify-me
START_VERIFY_TELEGRAM_PERMISSION=/verify-me
