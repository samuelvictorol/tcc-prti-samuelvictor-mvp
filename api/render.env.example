# API privada no Render. Nunca versione os valores reais dos segredos.
NODE_ENV=production
PORT=3000
API_PREFIX=/api

# A única URL pública é a do frontend. Ele encaminha /api e /socket.io.
PUBLIC_APP_URL=https://notify-flow.onrender.com
CORS_ORIGINS=https://notify-flow.onrender.com
TRUST_PROXY=1
COOKIE_SECURE=true

# Informe o banco explicitamente no caminho da URI.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/TesteDevelopment-db?appName=Cluster0
MONGODB_ENSURE_INDEXES=true
CONVERSATION_BACKUP_RETENTION_DAYS=90

# No Blueprint, REDIS_URL é injetada pelo Render Key Value.
REDIS_URL=redis://HOST_INTERNO_DO_RENDER:6379
REDIS_REQUIRED=true

JWT_ACCESS_SECRET=gere-um-segredo-access-aleatorio-exclusivo-com-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=gere-um-segredo-refresh-aleatorio-exclusivo-com-pelo-menos-32-caracteres
PROFILE_JWT_SECRET=gere-um-segredo-profile-aleatorio-exclusivo-com-pelo-menos-32-caracteres
ENCRYPTION_KEY=gere-uma-chave-encryption-aleatoria-exclusiva-com-pelo-menos-32-caracteres
SEARCH_HASH_KEY=gere-uma-chave-search-aleatoria-exclusiva-com-pelo-menos-32-caracteres
INVITE_TOKEN_SECRET=gere-um-segredo-invite-aleatorio-exclusivo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PROFILE_JWT_TTL=10m

PROFILE_CODE_TTL_SECONDS=600
PROFILE_CODE_MAX_ATTEMPTS=5
PROFILE_CODE_MAX_REQUESTS=5
PROFILE_CODE_WINDOW_SECONDS=3600
PROFILE_CODE_RESEND_SECONDS=60

ADMIN1_EMAIL=admin@seudominio.com
ADMIN1_PASSWORD=gere-uma-senha-administrativa-forte-e-exclusiva

START_NOTIFY_WHATSAPP_PERMISSION=/notify-me
START_VERIFY_TELEGRAM_PERMISSION=/verify-me
WHATSAPP_CLOUD_API_VERSION=v25.0

# Opcionais: podem permanecer vazios e ser cadastrados pela interface.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
GMAIL_FROM_NAME=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_DISPLAY_PHONE_NUMBER=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=


LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=20000
IP_BLOCK_AFTER=20
IP_BLOCK_SECONDS=900
