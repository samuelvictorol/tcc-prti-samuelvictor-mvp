# Portas/publicação local
FRONTEND_PORT=8080
API_PORT=3000
PUBLIC_APP_URL=http://localhost:8080
# Opcional: origem usada nas URLs publicas assinadas de imagem/video/documento.
# Em producao deve ser HTTPS; vazio reutiliza PUBLIC_APP_URL.
MEDIA_PUBLIC_BASE_URL=
# Opcional: vazio deriva uma chave separada de INVITE_TOKEN_SECRET.
MEDIA_SIGNING_SECRET=
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=1
LOG_LEVEL=info

# Autenticação — use segredos aleatórios fortes fora do ambiente local
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Acesso individual em /meu-perfil. PROFILE_JWT_SECRET e opcional: quando vazio,
# a API deriva uma chave separada e segura dos segredos existentes.
PROFILE_JWT_SECRET=
PROFILE_JWT_TTL=10m
PROFILE_CODE_TTL_SECONDS=600
PROFILE_CODE_MAX_ATTEMPTS=5
PROFILE_CODE_MAX_REQUESTS=5
PROFILE_CODE_WINDOW_SECONDS=3600
PROFILE_CODE_RESEND_SECONDS=30
CHAT_EMAIL_CODE_TTL_SECONDS=900
CHAT_EMAIL_CODE_RESEND_SECONDS=120
CHAT_EMAIL_CODE_MAX_ATTEMPTS=5
CHAT_EMAIL_CODE_MAX_REQUESTS=5
CHAT_EMAIL_CODE_WINDOW_SECONDS=3600
PROFILE_LINK_TTL_SECONDS=604800
PROFILE_SESSION_TTL_SECONDS=604800

# Criptografia de campos e índices cegos — trocar antes de cadastrar dados reais
ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
SEARCH_HASH_KEY=replace-with-a-different-long-random-secret
INVITE_TOKEN_SECRET=replace-with-a-third-long-random-secret

# Administradores de bootstrap. Adicione ADMIN2_*, ADMIN3_* etc. conforme necessário.
ADMIN1_EMAIL=admin@notify.local
ADMIN1_PASSWORD=replace-with-a-strong-unique-password
# ADMIN2_EMAIL=admin2@example.com
# ADMIN2_PASSWORD=another-strong-password


# MongoDB. O Compose usa o Mongo local quando esta variável não é definida.
# Para Atlas, mantenha o banco no caminho e substitua todos os marcadores.
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/SEU_BANCO?appName=SEU_APP
MONGODB_ENSURE_INDEXES=true
CONVERSATION_BACKUP_RETENTION_DAYS=90

# Segurança/limites
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=20000
MEDIA_RATE_LIMIT_MAX=20000
IP_BLOCK_AFTER=20
IP_BLOCK_SECONDS=900

# Integrações podem ser cadastradas pela tela Início. Estes valores são opcionais
# e servem somente como bootstrap, caso a API implemente leitura por ambiente.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=
GMAIL_FROM_NAME=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_API_VERSION=v25.0
TELEGRAM_BOT_USERNAME=
WHATSAPP_CLOUD_DISPLAY_PHONE_NUMBER=
START_NOTIFY_WHATSAPP_PERMISSION=/notify-me
START_VERIFY_TELEGRAM_PERMISSION=/verify-me
